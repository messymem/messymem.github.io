.DS_Store
._*
*.swp
Thumbs.db
node_modules/

# Original submission PDF (untracked): the copy the site serves lives at
# static/pdfs/messymem_corl2026.pdf, so don't store the same 8.4MB blob twice.
/_CoRL_2026_Submission__*.pdf

# Large source videos staged for conversion. Only the compressed results in
# static/videos/ belong in the repo -- never the multi-hundred-MB originals.
/media_src/

# Full-resolution simulation stills. The page serves the optimized .jpg copies
# beside them; keep the originals locally without committing tens of MB.
/static/images/simulation/*.png

# Paper PDFs are deliberately not tracked. They were purged from history; keep
# them locally in static/pdfs/ and link the site at an external copy instead.
/static/pdfs/*.pdf
