# Full-resolution simulation stills. The page serves the optimized .jpg copies
# beside them; keep the originals locally without committing tens of MB.
/static/images/simulation/*.png

# Publish only the submitted arXiv paper; keep draft PDFs local.
/static/pdfs/*.pdf
!/static/pdfs/MessyMem_arxiv.pdf
